---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Music from '../components/Music.astro';
import Live from '../components/Live.astro';
import Tape from '../components/Tape.astro';
import Footer from '../components/Footer.astro';

// トップは「聴く → ライブ → フォロー」の順だけ（docs/site-design.md）。
// PHOTO / VIDEO / GOODS / PROFILE / 過去のライブは全画面メニューから行く別ページ
---

<Base>
  <link slot="head" rel="preload" as="image" href="/logo/logo-full.webp" type="image/webp" />
  <!-- ロード時のロゴアニメーションを出すか: JSあり・動きを減らす設定なしのとき、リロードでも毎回出す -->
  <script slot="head" is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('is-intro');
    })();
  </script>
  <Intro />
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Music />
    <Tape />
    <Live />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/main.ts';
</script>

<style is:global>
  main {
    overflow-x: clip;
  }

  main:focus {
    outline: none;
  }
</style>
