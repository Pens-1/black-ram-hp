---
import { liveEnded, nextLive, print, srcset, windows } from '../data/site';

// 次のライブはスプレッドシートから（site.ts）。未来のライブがなければ最初から「近日発表」。
// 表示時にも main.ts が data-ends で判定して切り替える
const l = nextLive;
const ended = !l || liveEnded(l);
const pad = (n: number) => String(n).padStart(2, '0');
// 料金の括弧書き（＋1D …）は途中で改行させない
const [priceMain, priceRest] = (l?.price ?? '').split('（');
const priceNote = priceRest ? `（${priceRest}` : '';
const openStart = l ? [l.open, l.start].filter(Boolean).join(' / ') : '';
const openStartLabel = l ? [l.open && 'OPEN', l.start && 'START'].filter(Boolean).join(' / ') : '';
---

<section class="section live" id="live" aria-labelledby="live-title">
  <div class="wrap">
    <!-- 見出しは文字の窓: KYOTO MUSE の緑の照明の写真を文字の形で切り抜く（スクロールで少しずれる） -->
    <h2
      class="section-title live-title window-text"
      id="live-title"
      data-reveal
      data-window
      style={`--window:url("${windows.live.src}-s.webp")`}
    >
      NEXT LIVE
    </h2>

    {
      l && (
        <article
          class="next"
          data-next-live
          data-ends={l.endsAt}
          hidden={ended}
          aria-labelledby="next-venue"
          data-reveal="wipe"
        >
          <!-- 反転面の上側に、紙に刷ったコピーのようなライブ写真を刷り込み、下へ紙の色に溶かす -->
          <img
            class="print"
            src={`${print.src}-s.webp`}
            srcset={srcset(print)}
            sizes="100vw"
            width={print.w}
            height={print.h}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <p class="date">
            <time datetime={l.start ? `${l.date}T${l.start}+09:00` : l.date}>
              <span class="md">
                {pad(l.month)}.{pad(l.day)}
              </span>
              <span class="wd">（{l.weekday}）</span>
            </time>
          </p>
          <div class="body">
            <h3 class="where" id="next-venue">
              {l.area && <span class="area">{l.area}</span>}
              <span class="venue nowrap" translate="no">
                {l.venue}
              </span>
            </h3>
            {l.title && (
              <p class="event nowrap">
                「<span translate="no">{l.title}</span>」
              </p>
            )}
            <dl class="facts">
              {openStart && (
                <div>
                  <dt>{openStartLabel}</dt>
                  <dd class="num">{openStart}</dd>
                </div>
              )}
              {l.actTime && (
                <div>
                  <dt>出演時間</dt>
                  <dd class="num">{l.actTime}</dd>
                </div>
              )}
              {l.price && (
                <div>
                  <dt>料金</dt>
                  <dd>
                    {priceMain}
                    {priceNote && <span class="nowrap">{priceNote}</span>}
                  </dd>
                </div>
              )}
              {l.acts.length > 0 && (
                <div>
                  <dt>出演</dt>
                  <dd>
                    <ul class="acts" translate="no">
                      {l.acts.map((a) => (
                        <li class:list={['nowrap', { self: a.toUpperCase() === 'BLACK RAM' }]}>{a}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
            {l.ticket && (
              <p class="ticket-wrap">
                <a class="btn ext ticket" href={l.ticket} target="_blank" rel="noopener">
                  <span class="ja">チケット・予約</span>
                </a>
              </p>
            )}
          </div>
        </article>
      )
    }

    <p class="empty" data-next-empty hidden={!ended}>次のライブは近日発表</p>

    <p class="past" data-reveal>
      <a class="text-link" href="/past-live/">過去のライブ</a>
    </p>
  </div>
</section>

<style>
  .live-title {
    padding-bottom: 0.04em;
  }

  .next {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 24px;
    margin-inline: calc(var(--gutter) * -1);
    padding: 32px var(--gutter) 40px;
    background: var(--bone);
    color: var(--ink);
  }

  .print {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    width: 100%;
    height: clamp(180px, 56vw, 300px);
    object-fit: cover;
    object-position: 50% 40%;
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to bottom, #000 0 30%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0 30%, transparent 100%);
  }

  /* 日付は写真の溶けたところへ下ろして重ねる */
  .date {
    padding-top: clamp(96px, 34vw, 170px);
  }

  .next[hidden],
  .empty[hidden] {
    display: none;
  }

  .date {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .md {
    display: block;
    font-size: clamp(112px, 34vw, 280px);
  }

  .wd {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .body {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    font-weight: 700;
  }

  .area {
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .venue {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 30px + 5vw, 96px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .event {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 20px + 2vw, 44px);
    line-height: 1.1;
  }

  .facts {
    display: grid;
    margin-top: 8px;
    border-top: 1px solid rgb(13 12 11 / 0.3);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid rgb(13 12 11 / 0.3);
  }

  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    font-weight: 700;
  }

  .acts .self {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  /* 反転面の上のボタン: Ink の枠と文字、ホバーで Ink の面 */
  .ticket {
    border-color: var(--ink);
    color: var(--ink);
  }

  .ticket:hover {
    background: var(--ink);
    color: var(--bone);
  }

  .ticket:focus-visible {
    outline-color: var(--ink);
  }

  .empty {
    font-weight: 700;
    font-size: 20px;
    padding-block: 24px;
    border-block: 1px solid var(--line);
  }

  .past {
    margin-top: 32px;
    font-size: 13px;
    font-weight: 500;
  }

  .past a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ash);
  }

  .past a:hover {
    color: var(--bone);
  }

  @media (min-width: 768px) {
    .next {
      margin-inline: calc(var(--gutter) * -1);
      padding: 48px var(--gutter);
    }
  }

  /* PC: 日付を左、情報を右 */
  @media (min-width: 1200px) {
    .print {
      height: 300px;
    }

    /* PC: 日付と情報を写真の溶けきるあたりから始める（情報の文字を網点に重ねない） */
    .date {
      padding-top: 0;
    }

    .next {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 64px;
      align-items: end;
      padding: 240px var(--gutter) 56px;
    }

    .md {
      font-size: 280px;
    }

    .wd {
      font-size: 24px;
    }
  }
</style>
