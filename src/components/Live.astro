---
import { nextLive, nextLiveEnded } from '../data/site';

// ビルド時に終わっていれば最初から「近日発表」。表示時にも main.ts が data-ends で判定して切り替える
const ended = nextLiveEnded();
const l = nextLive;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section live" id="live" aria-labelledby="live-title">
  <div class="wrap">
    <h2 class="section-title" id="live-title" data-reveal>NEXT LIVE</h2>

    <article class="next" data-next-live data-ends={l.endsAt} hidden={ended} aria-labelledby="next-venue" data-reveal>
      <p class="date">
        <time datetime={`${l.date}T${l.start}+09:00`}>
          <span class="md">{pad(l.month)}.{pad(l.day)}</span>
          <span class="wd">（{l.weekday}）</span>
        </time>
      </p>
      <div class="body">
        <h3 class="where" id="next-venue">
          <span class="area">{l.area}</span>
          <span class="venue nowrap" translate="no">{l.venue}</span>
        </h3>
        <p class="event nowrap">「<span translate="no">{l.title}</span>」</p>
        <dl class="facts">
          <div>
            <dt>OPEN / START</dt>
            <dd class="num">{l.open} / {l.start}</dd>
          </div>
          <div>
            <dt>料金</dt>
            <dd>{l.price}</dd>
          </div>
          <div>
            <dt>出演</dt>
            <dd>
              <ul class="acts" translate="no">
                {l.acts.map((a) => <li class="nowrap">{a}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </article>

    <p class="empty" data-next-empty hidden={!ended}>次のライブは近日発表</p>

    <p class="past" data-reveal>
      <a class="text-link" href="/past-live/">過去のライブ</a>
    </p>
  </div>
</section>

<style>
  .next {
    display: grid;
    gap: 24px;
    margin-inline: calc(var(--gutter) * -1);
    padding: 32px var(--gutter) 40px;
    background: var(--bone);
    color: var(--ink);
  }

  .next[hidden],
  .empty[hidden] {
    display: none;
  }

  .date {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .md {
    display: block;
    font-size: clamp(112px, 34vw, 280px);
  }

  .wd {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .body {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    font-weight: 700;
  }

  .area {
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .venue {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 30px + 5vw, 96px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .event {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 20px + 2vw, 44px);
    line-height: 1.1;
  }

  .facts {
    display: grid;
    margin-top: 8px;
    border-top: 1px solid rgb(13 12 11 / 0.3);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid rgb(13 12 11 / 0.3);
  }

  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    font-weight: 700;
  }

  .acts li:first-child {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .empty {
    font-weight: 700;
    font-size: 20px;
    padding-block: 24px;
    border-block: 1px solid var(--line);
  }

  .past {
    margin-top: 32px;
    font-size: 13px;
    font-weight: 500;
  }

  .past a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ash);
  }

  .past a:hover {
    color: var(--bone);
  }

  @media (min-width: 768px) {
    .next {
      margin-inline: calc(var(--gutter) * -1);
      padding: 48px var(--gutter);
    }
  }

  /* PC: 日付を左、情報を右 */
  @media (min-width: 1200px) {
    .next {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 64px;
      align-items: end;
      padding: 56px var(--gutter) 56px;
    }

    .md {
      font-size: 280px;
    }

    .wd {
      font-size: 24px;
    }
  }
</style>
