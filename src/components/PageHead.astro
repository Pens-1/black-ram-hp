---
import { srcset, type Img } from '../data/site';

interface Props {
  title: string;
  photo: Img;
  /** object-position（写真のどこを見せるか） */
  focus?: string;
}
const { title, photo, focus = '50% 50%' } = Astro.props;
---

<!-- 別ページの冒頭: 1枚を断ち切りで全面に敷き、見出しを写真の上に直接組む -->
<header class="page-head grain">
  <img
    src={`${photo.src}.webp`}
    srcset={srcset(photo)}
    sizes="100vw"
    width={photo.w}
    height={photo.h}
    alt={photo.alt}
    fetchpriority="high"
    decoding="async"
    style={`object-position:${focus}`}
  />
  <div class="scrim" aria-hidden="true"></div>
  <div class="wrap head-inner">
    <h1 class="page-title">{title}</h1>
  </div>
</header>

<style>
  .page-head {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 72dvh;
    background: var(--ink);
  }

  .page-head img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.8);
  }

  .head-inner {
    position: relative;
    padding-block: 0 24px;
  }

  /* 写真の下端に食い込ませる */
  .page-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 24vw, 240px);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: -0.08em;
    overflow-wrap: normal;
    word-break: normal;
  }

  @media (min-width: 1200px) {
    .page-head {
      min-height: 82dvh;
    }
  }
</style>
