---
import { srcset, type Img } from '../data/site';

interface Props {
  title: string;
  photo: Img;
  /** object-position（写真のどこを見せるか） */
  focus?: string;
}
const { title, photo, focus = '50% 50%' } = Astro.props;
---

<!-- 別ページの冒頭: 1枚を断ち切りで全面に敷き、見出しを写真の上に直接組む -->
<header class="page-head grain">
  <img
    src={`${photo.src}.webp`}
    srcset={srcset(photo)}
    sizes="100vw"
    width={photo.w}
    height={photo.h}
    alt={photo.alt}
    fetchpriority="high"
    decoding="async"
    style={`object-position:${focus}`}
  />
  <div class="scrim" aria-hidden="true"></div>
  <div class="wrap head-inner">
    <h1 class="page-title">{title}</h1>
  </div>
</header>

<style>
  .page-head {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 72dvh;
    background: var(--ink);
  }

  .page-head img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.8);
  }

  /* スクロールで写真がゆっくり寄って沈む（スクロール量に連動するだけ） */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .page-head img {
        animation: head-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 80dvh;
      }
    }
  }

  @keyframes head-zoom {
    to {
      transform: scale(1.12) translateY(5%);
      filter: contrast(1.1) brightness(0.55);
    }
  }

  /* 見出しは開いたときに一度だけ RGB がずれてから合う（閃光なし） */
  @media (prefers-reduced-motion: no-preference) {
    .page-title {
      animation: title-in 720ms steps(1) both;
    }
  }

  @keyframes title-in {
    0% {
      opacity: 0;
    }
    12% {
      opacity: 1;
      transform: translateX(-4%) skewX(-6deg);
      text-shadow:
        -0.06em 0 rgb(255 0 60 / 0.8),
        0.06em 0 rgb(0 120 255 / 0.8);
    }
    30% {
      transform: translateX(3%);
      text-shadow:
        0.04em 0 rgb(255 0 60 / 0.7),
        -0.04em 0 rgb(0 120 255 / 0.7);
    }
    52% {
      transform: translateX(-1%) scaleX(1.04);
      text-shadow:
        -0.02em 0 rgb(255 0 60 / 0.6),
        0.02em 0 rgb(0 120 255 / 0.6);
    }
    70%,
    100% {
      transform: none;
      text-shadow: none;
    }
  }

  .head-inner {
    position: relative;
    padding-block: 0 24px;
  }

  /* 写真の下端に食い込ませる */
  .page-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 24vw, 240px);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: -0.08em;
    overflow-wrap: normal;
    word-break: normal;
  }

  @media (min-width: 1200px) {
    .page-head {
      min-height: 82dvh;
    }
  }
</style>
