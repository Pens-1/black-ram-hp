---
import { news } from '../data/site';
---

{
  news.length > 0 && (
    <section class="section" id="news" aria-labelledby="news-title">
      <div class="wrap">
        <h2 class="section-title" id="news-title">
          NEWS
        </h2>
        <ul class="news">
          {news.map((n) => (
            <li>
              <time class="date">{n.date}</time>
              {n.href ? (
                <a class="text-link" href={n.href}>
                  {n.text}
                </a>
              ) : (
                <span>{n.text}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .news li {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 16px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }

  .news li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .date {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ash);
  }
</style>
