---
// プロフィール。メンバー名・パート・紹介文は未確認なので空（入ったら文字を出す）。
// 縦の1枚を暗い白黒に刷った地（照明が当たった所だけ色が出る）として右へ断ち切りで敷き、
// アー写（カラー）をその上へ左から重ね、残りの2枚は段違いに置く
import Stage from './Stage.astro';
import { profile, srcset, stages, type Img } from '../data/site';
const wides = profile.sub.filter((s) => s.src !== stages.profile.lit.src);

const pic = (i: Img, sizes: string) => ({
  src: `${i.src}.webp`,
  srcset: srcset(i),
  sizes,
  width: i.w,
  height: i.h,
  alt: i.alt,
  loading: 'lazy' as const,
  decoding: 'async' as const,
});
---

<section class="profile" aria-label="プロフィール">
  <div class="wrap layout">
    <div class="tall" data-reveal="wipe">
      <Stage stage={stages.profile} sizes="(min-width: 768px) 55vw, 85vw" rest="50% 30%" class="tall-stage" />
    </div>

    <figure class="artist grain" data-reveal style="--i:1">
      <img {...pic(profile.main, '(min-width: 768px) 36vw, 70vw')} />
    </figure>

    {
      (profile.members.length > 0 || profile.text) && (
        <div class="text" data-reveal>
          {profile.members.length > 0 && (
            <ul class="members">
              {profile.members.map((m) => (
                <li>
                  <span class="nowrap">{m.name}</span> <span class="note">{m.part}</span>
                </li>
              ))}
            </ul>
          )}
          {profile.text && <p>{profile.text}</p>}
        </div>
      )
    }

    {
      wides.map((w, i) => (
        <figure class:list={['wide grain rgb-hover', `wide-${i}`]} data-reveal="wipe" style={`--i:${i}`}>
          <img {...pic(w, '(min-width: 768px) 45vw, 80vw')} />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .profile {
    padding-block: 0 96px;
  }

  .layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* スマホ: 縦の地を右へ断ち切り、アー写を左下に重ねる */
  .tall {
    grid-column: 3 / -1;
    grid-row: 1;
    margin-right: calc(var(--gutter) * -1);
  }

  .tall :global(.tall-stage) {
    aspect-ratio: 3 / 4;
  }

  .artist {
    grid-column: 1 / span 8;
    grid-row: 2;
    margin: -32vw 0 0 calc(var(--gutter) * -1);
    z-index: 1;
  }

  .text {
    grid-column: 1 / -1;
    padding-block: 32px;
    max-width: 36em;
    text-wrap: pretty;
  }

  .wide img {
    aspect-ratio: 4 / 3;
  }

  .wide-0 {
    grid-column: 4 / -1;
    margin: 48px calc(var(--gutter) * -1) 0 0;
  }

  .wide-1 {
    grid-column: 1 / span 10;
    margin: -10vw 0 0 calc(var(--gutter) * -1);
    z-index: 1;
  }

  @media (min-width: 768px) {
    .tall {
      grid-column: 6 / -1;
      grid-row: 1 / span 2;
    }

    .artist {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: end;
      margin: 0 0 -64px calc(var(--gutter) * -1);
    }

    .text {
      grid-column: 1 / span 5;
      grid-row: 1;
      align-self: end;
    }

    .wide-0 {
      grid-column: 1 / span 6;
      grid-row: 3;
      margin: 160px 0 0 calc(var(--gutter) * -1);
    }

    .wide-1 {
      grid-column: 6 / -1;
      grid-row: 3;
      margin: 260px calc(var(--gutter) * -1) 0 0;
      z-index: 0;
    }
  }
</style>
