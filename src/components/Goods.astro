---
// グッズ（Tシャツ）。購入方法は未確認なので写真だけ。
// 1枚目は暗い白黒に刷った地（照明が当たった所だけ色が出る）として断ち切りで敷き、残りは段違いに重ねる
import Stage from './Stage.astro';
import { goods, srcset, stages } from '../data/site';

interface Props {
  /** ページの見出しの地に使った写真（重ねて出さない） */
  exclude?: string;
}
const rest = goods.filter((g) => g.src !== Astro.props.exclude && g.src !== stages.goods.lit.src);
---

<section class="goods" aria-label="グッズの写真">
  <div class="main" data-reveal="wipe">
    <Stage stage={stages.goods} sizes="(min-width: 768px) 70vw, 100vw" rest="50% 45%" class="main-stage" />
  </div>
  <ul class="pile">
    {
      rest.map((g, i) => (
        <li class:list={['shot grain rgb-hover', `shot-${i}`]} data-reveal="wipe" style={`--i:${i % 2}`}>
          <img
            src={`${g.src}-s.webp`}
            srcset={srcset(g)}
            sizes="(min-width: 768px) 40vw, 75vw"
            width={g.w}
            height={g.h}
            alt={g.alt}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .goods {
    padding-block: 0 96px;
    max-width: var(--max);
    margin-inline: auto;
  }

  .main :global(.main-stage) {
    aspect-ratio: 1;
  }

  /* 段違いに重ねる。枠・影は付けず、重なりの順だけで前後を出す */
  .pile {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    margin-top: -18vw;
    position: relative;
  }

  .shot img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .shot-0 {
    grid-column: 1 / span 8;
    grid-row: 1;
  }

  .shot-1 {
    grid-column: 7 / -1;
    grid-row: 1;
    margin-top: 36vw;
  }

  .shot-2 {
    grid-column: 2 / span 7;
    grid-row: 2;
    margin-top: -14vw;
  }

  .shot-3 {
    grid-column: 8 / -1;
    grid-row: 2;
    margin-top: 30vw;
  }

  .shot-1,
  .shot-3 {
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot img {
      transition: transform 300ms var(--ease);
    }
  }

  @media (min-width: 768px) {
    .goods {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      padding-inline: var(--gutter);
    }

    /* PC: 地の1枚は画面に留め、右の写真だけが流れて重なっていく */
    .main {
      grid-column: 1 / span 7;
      grid-row: 1;
      margin-left: calc(var(--gutter) * -1);
      position: sticky;
      top: var(--header-h);
    }

    .pile {
      grid-column: 7 / -1;
      grid-row: 1;
      margin: 96px calc(var(--gutter) * -1) 0 0;
    }

    .shot-1 {
      margin-top: 22vw;
    }

    .shot-2 {
      margin-top: -8vw;
    }

    .shot-3 {
      margin-top: 18vw;
    }
  }

  @media (min-width: 1200px) {
    .goods {
      padding-inline: var(--gutter);
    }

    .pile {
      margin-top: 128px;
    }

    .shot-1 {
      margin-top: 260px;
    }

    .shot-2 {
      margin-top: -96px;
    }

    .shot-3 {
      margin-top: 220px;
    }
  }
</style>
