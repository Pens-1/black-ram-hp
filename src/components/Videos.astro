---
import Icon from './Icon.astro';
import { videos } from '../data/site';
---

<section class="section" id="video" aria-labelledby="video-title">
  <div class="wrap">
    <h2 class="section-title" id="video-title" data-reveal>VIDEO</h2>
  </div>
  <ul class="reels" aria-label="動画の一覧">
    {
      videos.map((v, i) => (
        <li class="reel" data-reveal style={`--i:${i}`}>
          <div class="frame grain" data-reel>
            <video
              preload="none"
              playsinline
              poster={v.poster}
              width={v.w}
              height={v.h}
              aria-label={v.label}
            >
              <source src={v.src} type="video/mp4" />
            </video>
            <button class="play" type="button" data-reel-play aria-label={`再生（音あり）: ${v.label}`}>
              <Icon name="play" size={24} />
            </button>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .reels {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72vw;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .reel {
    scroll-snap-align: start;
  }

  .frame {
    aspect-ratio: 9 / 16;
    background: var(--soot);
  }

  .frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    background: rgb(13 12 11 / 0.6);
    color: var(--bone);
    transition: background-color 220ms var(--ease);
  }

  .play :global(.icon) {
    /* 三角を光学的に中央へ */
    transform: translateX(2px);
  }

  .frame:hover .play {
    background: var(--ink);
  }

  .play:active {
    transform: translateY(1px);
  }

  .frame.is-playing .play,
  .frame.is-playing::after {
    display: none;
  }

  @media (min-width: 768px) {
    .reels {
      grid-auto-columns: 300px;
    }
  }

  /* PC: 横に並べ、段違いにする */
  @media (min-width: 1200px) {
    .reels {
      grid-auto-flow: row;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 24px;
      overflow: visible;
      max-width: var(--max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .reel:nth-child(1) {
      grid-column: 2 / span 3;
    }

    .reel:nth-child(2) {
      grid-column: 6 / span 3;
      margin-top: 96px;
    }

    .reel:nth-child(3) {
      grid-column: 10 / span 3;
      margin-top: 32px;
    }
  }
</style>
