---
import Shade from './Shade.astro';
import Stage from './Stage.astro';
import { hero, stages } from '../data/site';
---

<!--
  案C「暗転と照明」のファーストビュー。
  PC: 暗く沈めた白黒のライブ写真を全面に敷き、カーソルの照明が当たった部分だけ緑がにじむ。右の縦動画にも同じ照明が当たる。
  スマホ: 縦動画を全面に敷き、スクロール位置で照明が動く。下へ抜けると照明が絞られて暗転する。
-->
<section class="hero" id="top" aria-label="BLACK RAM" data-light-room>
  <Stage class="ground" stage={stages.hero} sizes="100vw" rest="30% 46%" eager />
  <!-- 映像は暗い白黒に沈め、照明の当たる部分だけ色を戻す（PCはカーソル、スマホはスクロール位置） -->
  <div class="media lamp" data-stage data-rest="50% 36%" style="--lx:50%;--ly:36%">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.poster}
      data-hero-video
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={hero.video} type="video/mp4" />
    </video>
    <Shade />
  </div>
  <div class="fade" aria-hidden="true"></div>
  <div class="film-wrap" aria-hidden="true"><div class="film"></div></div>
  <h1 class="logo">
    <img src="/logo/logo-full.webp" width="1200" height="1166" alt="BLACK RAM" fetchpriority="high" />
  </h1>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--ink);
  }

  /* 地の写真は PC だけ（スマホは動画が地） */
  .hero :global(.ground) {
    display: none;
  }

  .film-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .media {
    position: absolute;
    inset: 0;
    /* JSなし・動きを減らす設定で止まる照明 */
    --r: clamp(170px, 55vmin, 520px);
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* スマホ: 下側に Ink のグラデーションを敷いてロゴを下寄せ */
  .fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(13 12 11 / 0.92), rgb(13 12 11 / 0.3) 45%, transparent 70%);
  }

  .logo {
    position: relative;
    z-index: 1;
    width: min(86vw, 520px);
    margin: 0 0 max(40px, 6dvh) var(--gutter);
  }

  .logo img {
    width: 100%;
  }

  /* ロゴ: 筆で書かれるように左から現れる */
  @media (prefers-reduced-motion: no-preference) {
    .logo img {
      -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      -webkit-mask-size: 250% 100%;
      mask-size: 250% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      animation: brush 1.2s cubic-bezier(0.45, 0.05, 0.35, 1) 0.25s both;
    }
  }

  @keyframes brush {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .logo {
      width: min(60vw, 560px);
    }
  }

  /* PC: 動画は右寄せで高さいっぱい、左にロゴを大きく */
  @media (min-width: 1200px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      max-width: var(--max);
      margin-inline: auto;
      padding-left: var(--gutter);
      overflow: visible;
    }

    .media {
      position: relative;
      inset: auto;
      grid-column: 2;
      grid-row: 1;
      height: 100dvh;
      aspect-ratio: 9 / 16;
      margin-right: calc((100vw - min(100vw, var(--max))) / -2);
    }

    .hero :global(.ground) {
      display: block;
      position: absolute;
      inset: 0;
      /* 1360px の枠の外まで、画面の端から端へ敷く */
      left: calc((100vw - min(100vw, var(--max))) / -2);
      right: calc((100vw - min(100vw, var(--max))) / -2);
    }

    .hero :global(.ground img) {
      object-position: 50% 40%;
    }

    /* ロゴの下を暗く落としてコントラストを守る */
    .fade {
      left: calc((100vw - min(100vw, var(--max))) / -2);
      background: linear-gradient(to right, rgb(13 12 11 / 0.7), rgb(13 12 11 / 0.2) 50%, transparent 70%);
    }

    .film-wrap {
      left: calc((100vw - min(100vw, var(--max))) / -2);
      right: calc((100vw - min(100vw, var(--max))) / -2);
    }

    .media,
    .logo {
      z-index: 1;
    }

    .logo {
      grid-column: 1;
      grid-row: 1;
      width: min(100%, 680px);
      margin: var(--header-h) 0 0;
      /* ロゴの右端を動画に少しかぶせる */
      margin-right: -120px;
      z-index: 2;
    }
  }
</style>
