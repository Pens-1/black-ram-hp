---
import '../styles/global.css';
import { meta, NOINDEX, GA_ID, SITE_URL } from '../data/site';
import { toJsonLd } from '../data/jsonld';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** 構造化データ（JSON-LD）。配列なら1つずつ script にする */
  jsonLd?: object[];
}
const { title = meta.title, description = meta.description, noindex = false, jsonLd = [] } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
// 検索に載せないか: 全体フラグ（src/data/seo-config.ts）か、ページ単位（404 など）
const hideFromSearch = NOINDEX || noindex;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* デモ公開中は全ページ noindex。外すときは src/data/seo-config.ts の NOINDEX を false に（docs/seo.md） */}
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0d0c0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(meta.ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(meta.ogImage)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={toJsonLd(d)} />)}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      GA_ID && import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID, host: new URL(SITE_URL).hostname }}>
            if (location.hostname === host || location.hostname === 'www.' + host) {
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_ID);
            }
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>
    <slot />
  </body>
</html>
