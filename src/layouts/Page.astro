---
// 別ページ（/photo/ など）の共通の枠: ヘッダー → 冒頭の写真と見出し → 中身 → SNS / フッター
import Base from './Base.astro';
import Header from '../components/Header.astro';
import PageHead from '../components/PageHead.astro';
import Footer from '../components/Footer.astro';
import type { Img } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** <title> 用の日本語名（省略時は title） */
  seoTitle?: string;
  jsonLd?: object[];
  photo: Img;
  focus?: string;
}
const { title, description, seoTitle, jsonLd, photo, focus } = Astro.props;
---

<Base title={`${seoTitle ?? title} | BLACK RAM（京都のバンド）`} description={description} jsonLd={jsonLd}>
  <Header />
  <main id="main" tabindex="-1">
    <PageHead title={title} photo={photo} focus={focus} />
    <slot />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/main.ts';
</script>

<style is:global>
  main {
    overflow-x: clip;
  }

  main:focus {
    outline: none;
  }
</style>
